BACKUP_S3_HOST="web.s3.wisc.edu"
BACKUP_S3_KEY="my_s3_key_alphanumeric"
BACKUP_S3_SECRET="my_s3_secret_alphanumeric"
BACKUP_S3_BUCKET="my-bucket-name"
BACKUP_S3_PREFIX="my-dir-in-that-bucket"
BACKUP_S3_REGION=""
# Optional: path to a CA bundle (PEM) for TLS verification. Leave unset to use
# certifi / the system default. Only needed if you see CERTIFICATE_VERIFY_FAILED.
# BACKUP_S3_CA_BUNDLE="/etc/ssl/certs/ca-certificates.crt"

# --- ResearchDrive (backup_to_research_drive.py) ---
# The share name is the NetID of the PI who owns the ResearchDrive space.
BACKUP_RD_HOST="research.drive.wisc.edu"
BACKUP_RD_SHARE="pi_netid"
BACKUP_RD_PREFIX="my-dir-in-that-share"
# Optional: path where the share is already mounted. When set, the script
# uses it directly instead of mounting with gio.
# BACKUP_RD_MOUNT="/path/to/mounted/share"
